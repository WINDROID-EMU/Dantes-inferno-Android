<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FF6B6B">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#26DA3633" />
            <stroke
                android:width="1dp"
                android:color="#66F85149" />
            <padding
                android:left="14dp"
                android:top="8dp"
                android:right="14dp"
                android:bottom="8dp" />
        </shape>
    </item>
</ripple>
