<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_title_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Title Screen Artwork Background (Adapts to fill screen completely without cropping) -->
    <ImageView
        android:id="@+id/iv_title_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/title_screen"
        android:contentDescription="Silent Hill Downpour Title Screen" />

    <!-- Atmospheric Dark Vignette Overlay for High Contrast -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000" />

    <!-- Adaptive Safe-Area Content Container (Window insets applied dynamically in TitleActivity) -->
    <RelativeLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- Bottom Controls Bar (Stays pinned to bottom safe area, never collides) -->
        <RelativeLayout
            android:id="@+id/layout_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Right Controls: Settings Button & Optional Change ISO -->
            <LinearLayout
                android:id="@+id/layout_right_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_change_iso"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/btn_secondary"
                    android:text="Trocar ISO..."
                    android:textAllCaps="false"
                    android:textColor="#8B949E"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/btn_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="7dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="Configurações"
                        android:src="@drawable/ic_settings" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.04"
                        android:text="CONFIGURAÇÕES"
                        android:textColor="#F0F6FC"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Left Controls: Active Driver Status Badge (Constrained to never overlap right controls) -->
            <LinearLayout
                android:id="@+id/chip_gpu_driver"
                android:layout_width="277dp"
                android:layout_height="31dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="249dp"
                android:layout_toStartOf="@id/layout_right_controls"
                android:background="@drawable/bg_chip_status"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="GPU Driver"
                    android:src="@drawable/ic_gpu" />

                <TextView
                    android:id="@+id/tv_driver_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="GPU: Driver Turnip (AdrenoTools)"
                    android:textColor="#7EE787"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Center Interactive Area: Bounded strictly ABOVE layout_bottom_bar -->
        <LinearLayout
            android:id="@+id/layout_center_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/layout_bottom_bar"
            android:layout_alignParentTop="true"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Main Start Game Button (Self-sizing, fits any screen width/height) -->

            <!-- Status Message (Centered, non-wrapping on tight screens) -->

            <LinearLayout
                android:id="@+id/btn_start_game"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_title_start"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="22dp"
                android:paddingTop="11dp"
                android:paddingEnd="22dp"
                android:paddingBottom="11dp">

                <ImageView
                    android:id="@+id/iv_start_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="Iniciar"
                    android:src="@drawable/ic_play" />

                <TextView
                    android:id="@+id/tv_start_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:shadowColor="#80000000"
                    android:shadowDx="1"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:text="INICIAR JOGO"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_status_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_check" />

                <TextView
                    android:id="@+id/tv_game_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxWidth="440dp"
                    android:singleLine="true"
                    android:shadowColor="#FF000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:text="Dados do jogo carregados e prontos"
                    android:textColor="#C9D1D9"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </RelativeLayout>

    <!-- Dimming Loading Overlay (When picking/copying ISO) -->
    <FrameLayout
        android:id="@+id/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_card_dark"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ProgressBar
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/tv_loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:maxWidth="320dp"
                android:text="Processando ISO do jogo... Aguarde."
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Cinematic Fade to Black Overlay -->
    <View
        android:id="@+id/fade_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.0"
        android:background="#000000"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

</FrameLayout>
