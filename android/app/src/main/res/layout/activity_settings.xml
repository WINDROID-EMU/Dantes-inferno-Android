<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:orientation="vertical">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#161B22"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <LinearLayout
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textColor="#58A6FF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="VOLTAR AO MENU"
                android:textColor="#58A6FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="CONFIGURAÇÕES DO JOGO"
            android:textColor="#F0F6FC"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />
    </RelativeLayout>

    <!-- Scrollable Content with 2-Columns Landscape Layout -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Left Column: AdrenoTools Turnip Driver Manager -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:letterSpacing="0.08"
                    android:text="DRIVER GRÁFICO GPU (ADRENOTOOLS)"
                    android:textColor="#58A6FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical">

                    <!-- Switch: Use Turnip -->
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_use_turnip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Carregar Driver Turnip (AdrenoTools)"
                        android:textColor="#F0F6FC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp"
                        android:text="Substitui o driver Vulkan padrão do sistema pelo Turnip customizado via AdrenoTools para melhor desempenho e compatibilidade."
                        android:textColor="#8B949E"
                        android:textSize="12sp" />

                    <!-- Switch: Turbo Mode -->
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_turbo_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Modo Turbo (GPU Boost)"
                        android:textColor="#F0F6FC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="14dp"
                        android:text="Força frequências máximas de clock na GPU Adreno enquanto o jogo estiver aberto."
                        android:textColor="#8B949E"
                        android:textSize="12sp" />

                    <!-- Current Driver Info Box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_editor_dark"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Status do Driver:"
                            android:textColor="#8B949E"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_settings_driver_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Driver Turnip: vulkan.adreno.so [ATIVO]"
                            android:textColor="#7EE787"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Driver Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/btn_install_driver_zip"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/btn_secondary"
                            android:text="📁 Instalar Driver Turnip (.zip)..."
                            android:textAllCaps="false"
                            android:textColor="#F0F6FC"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_reset_system_driver"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/btn_secondary"
                            android:text="Usar Driver do Sistema (Qualcomm OEM)"
                            android:textAllCaps="false"
                            android:textColor="#8B949E"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Virtual Controller Settings Card -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:letterSpacing="0.08"
                    android:text="CONTROLE VIRTUAL NA TELA"
                    android:textColor="#58A6FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_virtual_controller"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Exibir Controles no Jogo"
                        android:textColor="#F0F6FC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp"
                        android:text="Exibe botões touch, analógicos e gatilhos (estilo Windroid) somente dentro do jogo."
                        android:textColor="#8B949E"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Opacidade dos Controles:"
                            android:textColor="#F0F6FC"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinner_controller_opacity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Quick TOML Performance Toggles -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:letterSpacing="0.08"
                    android:text="AJUSTES RÁPIDOS DE DESEMPENHO"
                    android:textColor="#58A6FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical">

                    <!-- Switch: Desativar Todo Debug e Logs -->
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_disable_debug"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Desativar Todo Debug e Logs (Sem Travamentos)"
                        android:textColor="#F0F6FC"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp"
                        android:text="Desliga completamente a gravação de logs em disco (downpour.log), camadas de validação Vulkan e rastreadores de debug. Elimina congelamentos e micro-travamentos no aparelho."
                        android:textColor="#8B949E"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="12dp"
                        android:background="#21262D" />

                    <!-- Internal Resolution (Guest Render Target) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Resolução Interna (Render UE3):"
                            android:textColor="#F0F6FC"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinner_resolution_scale"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="6dp"
                        android:text="Reduz a resolução dos alvos de renderização internos da Unreal Engine 3 (GBuffers/Shaders) para máximo FPS. A imagem é escalonada em tela cheia via FSR3 sem encolher a janela."
                        android:textColor="#8B949E"
                        android:textSize="11sp" />

                    <!-- FPS Limit -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Limite de Taxa de FPS:"
                            android:textColor="#F0F6FC"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinner_fps_limit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- VSync -->
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_vsync"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="VSync (Sincronização Vertical)"
                        android:textColor="#F0F6FC"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Vulkan Present Mode -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Modo Vulkan (Present Mode):"
                            android:textColor="#F0F6FC"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinner_vulkan_present_mode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- Present Effect / Upscaler -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Upscaler (Present Effect):"
                            android:textColor="#F0F6FC"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinner_present_effect"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- Async Shader Compilation -->
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_async_shaders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Compilação Assíncrona de Shaders"
                        android:textColor="#F0F6FC"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Compila shaders em segundo plano para evitar micro-travamentos (stutters) durante o jogo."
                        android:textColor="#8B949E"
                        android:textSize="11sp" />

                    <!-- Pipeline Threads -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Threads Compilação Pipeline:"
                            android:textColor="#F0F6FC"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinner_shader_threads"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- Texture Cache Memory Limits -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Cache de Texturas (VRAM/RAM):"
                            android:textColor="#F0F6FC"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinner_texture_cache"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Limites de memória para o cache de texturas. Valores de 512 MB ou mais impedem a destruição prematura de texturas e eliminam texturas brancas no Downpour."
                        android:textColor="#8B949E"
                        android:textSize="11sp" />

                    <!-- Anti-White Texture (gpu_allow_invalid_fetch_constants) -->
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_allow_invalid_fetch_constants"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Prevenção de Texturas Brancas (UE3)"
                        android:textColor="#F0F6FC"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Permite constantes transitórias de textura usadas pelo streaming da Unreal Engine 3, impedindo que texturas fiquem brancas durante a transição de mipmaps."
                        android:textColor="#8B949E"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_apply_quick_settings"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/btn_secondary"
                        android:text="Aplicar Ajustes ao downpour.toml"
                        android:textAllCaps="false"
                        android:textColor="#58A6FF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Shader Cache Management -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:letterSpacing="0.08"
                    android:text="GERENCIAMENTO DE SHADER CACHE"
                    android:textColor="#58A6FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Cache Armazenado em Disco:"
                            android:textColor="#F0F6FC"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_shader_cache_size"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00 MB"
                            android:textColor="#3FB950"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:text="Armazena os shaders SPIR-V e pipelines pré-compilados. Se você trocar de driver Turnip ou observar glitches visuais, limpe o cache."
                        android:textColor="#8B949E"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_clear_shader_cache"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/btn_danger"
                        android:text="Limpar Cache de Shaders e Pipelines"
                        android:textAllCaps="false"
                        android:textColor="#F85149"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- Right Column: Full downpour.toml Raw Editor -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="invisible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:letterSpacing="0.08"
                    android:text="EDITOR DIRETO DO TOML (DOWNPOUR.TOML)"
                    android:textColor="#58A6FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Edite qualquer parâmetro avançado de renderização, áudio ou controles. As alterações são salvas diretamente no arquivo de configuração do jogo."
                        android:textColor="#8B949E"
                        android:textSize="12sp" />

                    <!-- TOML Text Editor Field -->
                    <EditText
                        android:id="@+id/et_toml_content"
                        android:layout_width="match_parent"
                        android:layout_height="270dp"
                        android:background="@drawable/bg_editor_dark"
                        android:fontFamily="monospace"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:scrollbars="vertical"
                        android:textColor="#E6EDF3"
                        android:textSize="12sp" />

                    <!-- Action Buttons for TOML -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_save_toml"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_title_start"
                            android:text="💾 Salvar TOML"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_reload_toml"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_secondary"
                            android:text="🔄 Restaurar Padrão"
                            android:textAllCaps="false"
                            android:textColor="#8B949E"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
