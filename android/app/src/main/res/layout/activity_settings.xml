<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:orientation="vertical">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#161B22"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textColor="#58A6FF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:letterSpacing="0.05"
                android:text="VOLTAR"
                android:textColor="#58A6FF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:letterSpacing="0.08"
            android:text="CONFIGURAÇÕES DO DANTE'S INFERNO"
            android:textColor="#F0F6FC"
            android:textSize="14sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Scrollable Content with 2 Proportional Columns -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Left Column: GPU Driver, Touch Controls & Debug -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Section: GPU Driver -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:letterSpacing="0.06"
                    android:text="DRIVER GRÁFICO GPU (ADRENOTOOLS)"
                    android:textColor="#58A6FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_use_turnip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Driver Turnip Customizado"
                        android:textColor="#F0F6FC"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp"
                        android:text="Usa driver Mesa Turnip. Desative para usar o driver Qualcomm padrão."
                        android:textColor="#8B949E"
                        android:textSize="11sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_turbo_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Modo Turbo (GPU Boost)"
                        android:textColor="#F0F6FC"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp"
                        android:text="Solicita frequências máximas de clock para a GPU Adreno."
                        android:textColor="#8B949E"
                        android:textSize="11sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_a6xx_compat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Compatibilidade Adreno 6xx (sysmem, nolrz)"
                        android:textColor="#F0F6FC"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp"
                        android:text="Força direct-to-system-memory e desativa GMEM tiling/UBWC (TU_DEBUG=sysmem,nolrz,noubwc). Corrige tela preta em Adreno 650/660."
                        android:textColor="#8B949E"
                        android:textSize="11sp" />

                    <!-- Current Driver Info Box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_editor_dark"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Status do Driver:"
                            android:textColor="#8B949E"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tv_settings_driver_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Driver do Sistema: Qualcomm OEM [ATIVO]"
                            android:textColor="#7EE787"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Driver Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/btn_install_driver_zip"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:background="@drawable/btn_secondary"
                            android:text="📁 Instalar Driver Turnip (.zip)..."
                            android:textAllCaps="false"
                            android:textColor="#F0F6FC"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_reset_system_driver"
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/btn_secondary"
                            android:text="Restaurar Driver do Sistema (Qualcomm)"
                            android:textAllCaps="false"
                            android:textColor="#8B949E"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Section: Virtual Touch Controller -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:letterSpacing="0.06"
                    android:text="CONTROLES VIRTUAIS NA TELA"
                    android:textColor="#58A6FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_virtual_controller"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Exibir Controles Touch"
                        android:textColor="#F0F6FC"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp"
                        android:text="Desative caso utilize controle Bluetooth ou USB-C."
                        android:textColor="#8B949E"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Opacidade dos Controles:"
                        android:textColor="#F0F6FC"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinner_controller_opacity"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_spinner_field" />
                </LinearLayout>

                <!-- Section: Stability & Debug Logs -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:letterSpacing="0.06"
                    android:text="ESTABILIDADE E DESEMPENHO"
                    android:textColor="#58A6FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_disable_debug"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Desativar Logs em Disco (Zero Stutters)"
                        android:textColor="#F0F6FC"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp"
                        android:text="Desativa gravação de logs e validação de GPU, eliminando travamentos."
                        android:textColor="#8B949E"
                        android:textSize="11sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_show_fps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Contador de FPS em Tempo Real"
                        android:textColor="#F0F6FC"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp"
                        android:text="Exibe o HUD no centro superior com os FPS reais e tempo de quadro (ms)."
                        android:textColor="#8B949E"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Opacidade do Contador FPS:"
                        android:textColor="#F0F6FC"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinner_fps_opacity"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_spinner_field" />
                </LinearLayout>

            </LinearLayout>

            <!-- Right Column: Graphics, Display, Shaders & Cache -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:letterSpacing="0.06"
                    android:text="CONFIGURAÇÕES GRÁFICAS (VULKAN)"
                    android:textColor="#58A6FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <!-- Internal Resolution Scale -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Escala de Resolução:"
                        android:textColor="#F0F6FC"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinner_resolution_scale"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_spinner_field" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp"
                        android:text="720p nativo Xbox 360 (rápido) ou 1080p para maior nitidez."
                        android:textColor="#8B949E"
                        android:textSize="10sp" />

                    <!-- VSync -->
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_vsync"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="VSync (Sincronização Vertical)"
                        android:textColor="#F0F6FC"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp"
                        android:text="Evita cortes na imagem sincronizando com a taxa da tela."
                        android:textColor="#8B949E"
                        android:textSize="10sp" />

                    <!-- Upscaler / Present Effect -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Filtro de Pós-Processamento:"
                        android:textColor="#F0F6FC"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinner_present_effect"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_spinner_field" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp"
                        android:text="FXAA suaviza serrilhados. CAS e FSR elevam a nitidez."
                        android:textColor="#8B949E"
                        android:textSize="10sp" />

                    <!-- Anisotropic Texture Filtering -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Filtro Anisotrópico (Textura):"
                        android:textColor="#F0F6FC"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinner_anisotropic"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_spinner_field" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp"
                        android:text="Desativado (0x) reduz drasticamente o uso de memória e eleva os FPS no celular."
                        android:textColor="#8B949E"
                        android:textSize="10sp" />

                    <!-- Vulkan Present Mode -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Modo Vulkan (Present Mode):"
                        android:textColor="#F0F6FC"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinner_vulkan_present_mode"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_spinner_field" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp"
                        android:text="FIFO para estabilidade, Mailbox para ultra baixa latência."
                        android:textColor="#8B949E"
                        android:textSize="10sp" />

                    <!-- Async Shader Compilation -->
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_async_shaders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Compilação Assíncrona de Shaders"
                        android:textColor="#F0F6FC"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp"
                        android:text="Compila shaders em segundo plano para evitar micro-travamentos."
                        android:textColor="#8B949E"
                        android:textSize="10sp" />

                    <!-- Pipeline Threads -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Threads de Criação de Pipeline:"
                        android:textColor="#F0F6FC"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinner_shader_threads"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_spinner_field" />

                </LinearLayout>

                <!-- Section: Shader Cache Management -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:letterSpacing="0.06"
                    android:text="GERENCIAMENTO DE SHADER CACHE"
                    android:textColor="#58A6FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Cache em Disco:"
                            android:textColor="#F0F6FC"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_shader_cache_size"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00 MB"
                            android:textColor="#7EE787"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_clear_shader_cache"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/btn_danger"
                        android:text="Limpar Cache de Shaders"
                        android:textAllCaps="false"
                        android:textColor="#F85149"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Section: Atualizações do App -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:letterSpacing="0.06"
                    android:text="ATUALIZAÇÕES DO JOGO"
                    android:textColor="#58A6FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <Button
                        android:id="@+id/btn_check_updates"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="@drawable/btn_secondary"
                        android:text="🔄 Verificar Atualizações no GitHub..."
                        android:textAllCaps="false"
                        android:textColor="#58A6FF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Save Button -->
                <Button
                    android:id="@+id/btn_apply_quick_settings"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/btn_title_start"
                    android:text="💾 Salvar e Aplicar Configurações"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Process Restart Button -->
                <Button
                    android:id="@+id/btn_restart_app"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/btn_secondary"
                    android:text="⚡ Reiniciar App (Limpeza de Processo)"
                    android:textAllCaps="false"
                    android:textColor="#58A6FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
