<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:orientation="vertical">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="#161B22"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textColor="#58A6FF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:letterSpacing="0.05"
                android:text="VOLTAR AO MENU"
                android:textColor="#58A6FF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:letterSpacing="0.08"
            android:text="CONFIGURAÇÕES DO DANTE'S INFERNO"
            android:textColor="#F0F6FC"
            android:textSize="15sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Scrollable Content with 2-Columns Landscape Layout -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Left Column: GPU Driver, Touch Controls & Debug -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Section: GPU Driver -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:letterSpacing="0.08"
                    android:text="DRIVER GRÁFICO GPU (ADRENOTOOLS)"
                    android:textColor="#58A6FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Switch: Use Turnip -->
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_use_turnip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Driver Turnip Customizado"
                        android:textColor="#F0F6FC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10dp"
                        android:text="Usa driver Mesa Turnip via AdrenoTools. Desative para usar o driver padrão Qualcomm do sistema."
                        android:textColor="#8B949E"
                        android:textSize="11sp" />

                    <!-- Switch: Turbo Mode -->
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_turbo_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Modo Turbo (GPU Boost)"
                        android:textColor="#F0F6FC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10dp"
                        android:text="Solicita frequências máximas de clock para a GPU Adreno durante a execução."
                        android:textColor="#8B949E"
                        android:textSize="11sp" />

                    <!-- Current Driver Info Box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_editor_dark"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Status do Driver:"
                            android:textColor="#8B949E"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tv_settings_driver_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Driver do Sistema: Qualcomm OEM [ATIVO]"
                            android:textColor="#7EE787"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Driver Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/btn_install_driver_zip"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/btn_secondary"
                            android:text="📁 Instalar Driver Turnip (.zip)..."
                            android:textAllCaps="false"
                            android:textColor="#F0F6FC"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_reset_system_driver"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/btn_secondary"
                            android:text="Restaurar Driver do Sistema (Qualcomm)"
                            android:textAllCaps="false"
                            android:textColor="#8B949E"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Section: Virtual Touch Controller -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="6dp"
                    android:letterSpacing="0.08"
                    android:text="CONTROLES VIRTUAIS NA TELA"
                    android:textColor="#58A6FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_virtual_controller"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Exibir Controles Touch na Tela"
                        android:textColor="#F0F6FC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10dp"
                        android:text="Exibe botões touch, analógicos e gatilhos na tela. Desative caso vá utilizar gamepad Bluetooth/USB."
                        android:textColor="#8B949E"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Opacidade dos Controles:"
                            android:textColor="#F0F6FC"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinner_controller_opacity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Section: Stability & Debug Logs -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="6dp"
                    android:letterSpacing="0.08"
                    android:text="ESTABILIDADE E DESEMPENHO"
                    android:textColor="#58A6FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_disable_debug"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Desativar Logs em Disco (Zero Stutters)"
                        android:textColor="#F0F6FC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Desativa escrita constante de logs em disco e validação de GPU, eliminando micro-travamentos no celular."
                        android:textColor="#8B949E"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Right Column: Graphics, Display, Shaders & Cache -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:letterSpacing="0.08"
                    android:text="CONFIGURAÇÕES GRÁFICAS (VULKAN)"
                    android:textColor="#58A6FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Internal Resolution Scale -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Escala de Resolução:"
                            android:textColor="#F0F6FC"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinner_resolution_scale"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10dp"
                        android:text="720p é a resolução original do Xbox 360 (máximo desempenho). 1080p melhora a nitidez em celulares potentes."
                        android:textColor="#8B949E"
                        android:textSize="11sp" />

                    <!-- VSync -->
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_vsync"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="VSync (Sincronização Vertical)"
                        android:textColor="#F0F6FC"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10dp"
                        android:text="Evita cortes na imagem (tearing) sincronizando a taxa de quadros à tela do celular."
                        android:textColor="#8B949E"
                        android:textSize="11sp" />

                    <!-- Upscaler / Present Effect -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Filtro de Pós-Processamento:"
                            android:textColor="#F0F6FC"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinner_present_effect"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10dp"
                        android:text="FXAA suaviza bordas serrilhadas. CAS e FSR aumentam a nitidez da imagem sem custo de desempenho."
                        android:textColor="#8B949E"
                        android:textSize="11sp" />

                    <!-- Vulkan Present Mode -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Modo Vulkan (Present Mode):"
                            android:textColor="#F0F6FC"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinner_vulkan_present_mode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10dp"
                        android:text="FIFO oferece estabilidade com VSync. Mailbox oferece a menor latência de resposta nos toques."
                        android:textColor="#8B949E"
                        android:textSize="11sp" />

                    <!-- Async Shader Compilation -->
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_async_shaders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Compilação Assíncrona de Shaders"
                        android:textColor="#F0F6FC"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10dp"
                        android:text="Compila shaders em threads secundárias, reduzindo travamentos durante combate e efeitos visuais."
                        android:textColor="#8B949E"
                        android:textSize="11sp" />

                    <!-- Pipeline Threads -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Threads de Criação de Pipeline:"
                            android:textColor="#F0F6FC"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinner_shader_threads"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Section: Shader Cache Management -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="6dp"
                    android:letterSpacing="0.08"
                    android:text="GERENCIAMENTO DE SHADER CACHE"
                    android:textColor="#58A6FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Cache Armazenado em Disco:"
                            android:textColor="#F0F6FC"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_shader_cache_size"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00 MB"
                            android:textColor="#7EE787"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:layout_marginBottom="10dp"
                        android:text="Se você trocar de driver Turnip ou observar glitches visuais, limpe o cache de shaders."
                        android:textColor="#8B949E"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_clear_shader_cache"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="@drawable/btn_danger"
                        android:text="Limpar Cache de Shaders e Pipelines"
                        android:textAllCaps="false"
                        android:textColor="#F85149"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Section: Apply and Save Button -->
                <Button
                    android:id="@+id/btn_apply_quick_settings"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/btn_title_start"
                    android:text="💾 Salvar e Aplicar Configurações"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
